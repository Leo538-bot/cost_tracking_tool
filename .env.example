# Kopiere diese Datei nach .env und trage eigene Werte ein:
#   cp .env.example .env
#
# Zwei Werte MUSST du selbst setzen. Beide erzeugst du mit:
#   openssl rand -base64 32

# Passwort der Datenbank. Nur intern zwischen den Containern benutzt.
POSTGRES_PASSWORD=hier-ein-langes-zufaelliges-passwort

# Signaturschluessel fuer die Login-Tokens. Mindestens 32 Zeichen -- die App
# startet nicht, wenn er zu kurz ist oder noch der eingebaute Standard.
# Aenderst du ihn spaeter, muessen sich alle neu anmelden.
JWT_SECRET=hier-ein-anderes-langes-zufaelliges-geheimnis

# --- optional ---------------------------------------------------------------

POSTGRES_USER=tripcost
POSTGRES_DB=tripcost

# Port, unter dem die App erreichbar ist: http://localhost:8080
# Schon belegt? Einfach einen anderen eintragen, z.B. 8090.
WEB_PORT=8080

# An welche Adresse gebunden wird.
#   127.0.0.1 = nur lokal auf dem Server (richtig fuer den Cloudflare Tunnel)
#   0.0.0.0   = auch aus dem LAN erreichbar, ungeschuetzt und ohne HTTPS
WEB_BIND=127.0.0.1

# Wie lange ein Handy angemeldet bleibt, in Tagen.
SESSION_DAYS=90

# Nur noetig, wenn du das Frontend getrennt betreibst (z.B. `npm run dev`).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Interaktive API-Doku unter /docs. Standardmaessig aus, weil sie einem Scanner
# saemtliche Endpunkte auflistet. Nur lokal zum Entwickeln einschalten.
DOCS_ENABLED=false

# --- Cloudflare Tunnel (optional) -------------------------------------------
# Macht die App unter einer eigenen HTTPS-Adresse erreichbar, ohne einen Port
# im Router zu oeffnen. Token holst du dir unter:
#   Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel
# Der Tunnel muss dort auf den Service  http://web:80  zeigen.
# Starten dann mit:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
